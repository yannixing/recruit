<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recruit.mapper.DashboardMapper">

    <select id="countAllJobs" resultType="java.lang.Long">
        select count(1)
        from job
        <if test="hrId != null">
            where hr_id = #{hrId}
        </if>
    </select>

    <select id="countActiveJobs" resultType="java.lang.Long">
        select count(1)
        from job
        where status = 1
        <if test="hrId != null">
            and hr_id = #{hrId}
        </if>
    </select>

    <select id="countPendingJobs" resultType="java.lang.Long">
        select count(1)
        from job
        where status = 0
        <if test="hrId != null">
            and hr_id = #{hrId}
        </if>
    </select>

    <select id="countDeliveries" resultType="java.lang.Long">
        select count(1)
        from delivery d
        left join job j on j.id = d.job_id
        <if test="hrId != null">
            where j.hr_id = #{hrId}
        </if>
    </select>

    <select id="countInterviews" resultType="java.lang.Long">
        select count(1)
        from interview i
        <if test="hrId != null">
            where i.hr_id = #{hrId}
        </if>
    </select>

    <select id="countUsers" resultType="java.lang.Long">
        select count(1) from `user`
    </select>

    <select id="countUsersByRole" resultType="java.lang.Long">
        select count(1) from `user` where role = #{role}
    </select>
</mapper>
